{
  "name": "deepbox",
  "version": "1.0.0",
  "private": true,
  "description": "DeepBox - FullStack Payment Orders Orchestrator",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "dotnet watch --non-interactive --project backend/src/Api run",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "dotnet build backend/DeepBox.sln && npm run build --prefix frontend",
    "test": "dotnet test backend/DeepBox.sln && npm test --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
